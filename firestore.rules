rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'super_admin';
    }

    function isCoach() {
      return role() == 'coach';
    }

    function isParent() {
      return role() == 'parent';
    }

    function isPlayer() {
      return role() == 'player';
    }

    // A coach may only touch teams/players they are assigned to.
    function isAssignedCoachOfTeam(teamId) {
      return isCoach() && teamId in userDoc().data.linkedTeamIds;
    }

    // A parent may only read/write player records they supervise. A player
    // may be supervised by more than one parent account, hence the array.
    function isOwningParent(parentUserIds) {
      return isParent() && request.auth.uid in parentUserIds;
    }

    // A player may only read their own linked record.
    function isOwningPlayer(playerUserId) {
      return isPlayer() && request.auth.uid == playerUserId;
    }

    function playerData(playerId) {
      return get(/databases/$(database)/documents/players/$(playerId)).data;
    }

    // ---- users ----
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Role can never be self-escalated by the user — only an admin can change it.
      allow update: if isAdmin() ||
        (request.auth.uid == userId && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---- players ----
    match /players/{playerId} {
      allow read: if isAdmin() ||
        isOwningParent(resource.data.parentUserIds) ||
        isOwningPlayer(resource.data.playerUserId) ||
        isAssignedCoachOfTeam(resource.data.teamId);
      allow create: if isAdmin();
      // A player may update only their own non-official fields (their
      // account link and basic profile bits) — never their own official
      // team/level/status, which stays admin/coach-only.
      allow update: if isAdmin() || isAssignedCoachOfTeam(resource.data.teamId);
      allow delete: if isAdmin();
    }

    // ---- coaches ----
    match /coaches/{coachId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- teams ----
    match /teams/{teamId} {
      allow read: if true; // public — teams are shown on the marketing site
      allow write: if isAdmin();
    }

    // ---- programs ----
    match /programs/{programId} {
      allow read: if true; // public
      allow write: if isAdmin();
    }

    // ---- trainingSessions ----
    match /trainingSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() || isAssignedCoachOfTeam(resource.data.teamId);
      allow delete: if isAdmin();
    }

    // ---- attendance ----
    match /attendance/{recordId} {
      allow read: if isAdmin() || isCoach() ||
        (isParent() && request.auth.uid in playerData(resource.data.playerId).parentUserIds) ||
        (isPlayer() && request.auth.uid == playerData(resource.data.playerId).playerUserId);
      // Parents AND players may self-check-in via the QR scanner — but only
      // as "present", and only for a player they actually own/are.
      // Coaches/admins can still mark any status for any player on their teams.
      allow create: if isAdmin() || isCoach() ||
        (request.resource.data.status == 'present' &&
          ((isParent() && request.auth.uid in playerData(request.resource.data.playerId).parentUserIds) ||
           (isPlayer() && request.auth.uid == playerData(request.resource.data.playerId).playerUserId)));
      allow update: if isAdmin() || isCoach();
      allow delete: if isAdmin();
    }

    // ---- performanceEvaluations ----
    match /performanceEvaluations/{evalId} {
      allow read: if isAdmin() ||
        (isCoach() && resource.data.coachId == request.auth.uid) ||
        (isParent() && request.auth.uid in playerData(resource.data.playerId).parentUserIds) ||
        (isPlayer() && request.auth.uid == playerData(resource.data.playerId).playerUserId);
      allow create, update: if isAdmin() || isCoach();
      allow delete: if isAdmin();
    }

    // ---- matches ----
    match /matches/{matchId} {
      allow read: if true; // public
      allow write: if isAdmin();
    }

    // ---- announcements ----
    match /announcements/{announcementId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // ---- gallery ----
    match /gallery/{itemId} {
      allow read: if true; // public
      allow write: if isAdmin() || isCoach();
    }

    // ---- dailyTasks ----
    // Coaches assign; a player may only flip `completed` on their own
    // task and can never change its title, date, or who assigned it.
    match /dailyTasks/{taskId} {
      allow read: if isAdmin() || isCoach() ||
        (isParent() && request.auth.uid in playerData(resource.data.playerId).parentUserIds) ||
        (isPlayer() && request.auth.uid == playerData(resource.data.playerId).playerUserId);
      allow create: if isAdmin() || isCoach();
      allow update: if isAdmin() || isCoach() ||
        (isPlayer() &&
          request.auth.uid == playerData(resource.data.playerId).playerUserId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed']));
      allow delete: if isAdmin() || isCoach();
    }

    // ---- matchPlayerStats ----
    // Coaches/admins enter these after a match; players/parents can only
    // ever read their own player's numbers, never edit them.
    match /matchPlayerStats/{statId} {
      allow read: if isAdmin() || isCoach() ||
        (isParent() && request.auth.uid in playerData(resource.data.playerId).parentUserIds) ||
        (isPlayer() && request.auth.uid == playerData(resource.data.playerId).playerUserId);
      allow write: if isAdmin() || isCoach();
    }

    // ---- registrations ----
    match /registrations/{registrationId} {
      allow create: if isSignedIn(); // anyone signed in (freshly created parent account) can submit
      allow read: if isAdmin() || resource.data.parentEmail == request.auth.token.email;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- conversations (parent <-> coaching staff messaging) ----
    // The conversation document's id is always the parent's own auth uid,
    // which is what makes the parent-side check a simple id comparison
    // instead of a get() lookup.
    match /conversations/{conversationId} {
      allow read, write: if isAdmin() || isCoach() || (isParent() && conversationId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAdmin() || isCoach() || (isParent() && conversationId == request.auth.uid);
        // Anyone in the conversation can post, but only as themselves —
        // never on behalf of another user.
        allow create: if (isAdmin() || isCoach() || (isParent() && conversationId == request.auth.uid))
          && request.resource.data.senderId == request.auth.uid;
        // Messages are an immutable log once sent.
        allow update, delete: if false;
      }
    }
  }
}
